{
  "info": {
    "name": "PokeMerch · Pruebas de tokens",
    "description": "Ejecuta la colección completa en orden con el Collection Runner. Configura baseUrl, authTestEmail y authTestPassword en el entorno activo. Usa una cuenta local ficticia ya registrada. Las pruebas crean y revocan sus propias sesiones y guardan los tokens solo durante la ejecución.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 · Login",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "for (const key of [\"accessToken\", \"refreshToken\", \"previousRefreshToken\"]) pm.variables.set(key, \"\");",
              "if (!pm.variables.get(\"authTestEmail\") || !pm.variables.get(\"authTestPassword\")) {",
              "  throw new Error(\"Configura authTestEmail y authTestPassword con una cuenta local de prueba.\");",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Devuelve ambos JWT y omite hashes\", () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.success).to.equal(true);",
              "  const data = body.data;",
              "  pm.expect(data.tokenType).to.equal(\"Bearer\");",
              "  for (const key of [\"accessToken\", \"refreshToken\"]) {",
              "    pm.expect(data[key]).to.match(/^[\\w-]+\\.[\\w-]+\\.[\\w-]+$/);",
              "  }",
              "  pm.expect(data.accessToken).not.to.equal(data.refreshToken);",
              "  pm.expect(data.user).not.to.have.property(\"passwordHash\");",
              "  pm.expect(data).not.to.have.property(\"tokenHash\");",
              "  if (pm.response.code === 200) {",
              "    pm.variables.set(\"accessToken\", data.accessToken);",
              "    pm.variables.set(\"refreshToken\", data.refreshToken);",
              "    pm.variables.set(\"previousRefreshToken\", data.refreshToken);",
              "  }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{authTestEmail}}\",\n  \"password\": \"{{authTestPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
